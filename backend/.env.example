# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already excluded via .gitignore.
# See /docs/setup_environment_credentials.md for how to obtain each value.

# --- Twilio (SMS/call gateway for escalation) ---
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# --- Firebase (Auth, Firestore, Storage) ---
FIREBASE_API_KEY=your_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# --- Google Cloud (Vision OCR, Maps/Places, Text-to-Speech) ---
# Billed project (Blaze) — separate from the Gemini project below
GOOGLE_CLOUD_VISION_API_KEY=your_key_here
GOOGLE_MAPS_API_KEY=your_key_here
GOOGLE_TTS_API_KEY=your_key_here

# --- Gemini (LLM provider) ---
# Must be linked to an UNBILLED project ("Default Gemini Project" in AI Studio)
# See tech_stack.md §2b for why this must stay separate from the Blaze project above
GEMINI_API_KEY=your_key_here
