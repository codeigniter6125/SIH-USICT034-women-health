# Copy this file to .env.local (Next.js convention, not .env) and fill in real values.
# These are the SAME Firebase web config values already in backend/.env —
# just re-prefixed with NEXT_PUBLIC_ so Next.js exposes them to browser code.
# (Firebase web config values are not secret — see docs/setup_environment_credentials.md.)

NEXT_PUBLIC_FIREBASE_API_KEY=your_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Your local FastAPI backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
